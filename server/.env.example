# Copy to .env for local development
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5433/letbet
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080

# SMS for one-time codes: console (dev) | termii
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER=LetBet

# Odds feed: demo | oddsapi (The Odds API – key in Railway variables only, never in git)
ODDS_PROVIDER=demo
ODDS_API_KEY=

# Email: console (dev, logs only) | smtp | resend | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM="LetBetAfrika <no-reply@letbetafrika.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
SENDGRID_API_KEY=
SITE_URL=http://127.0.0.1:8080
SUPPORT_EMAIL=support@letbetafrika.com

# Payments: demo (instant credit) | paystack | flutterwave
PAYMENTS_MODE=demo
REQUIRE_KYC=false
