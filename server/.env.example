# Copy to .env for local development
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5433/letbet
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080

# SMS for one-time codes: console (dev) | termii
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER=LetBet

# Odds feed: demo | oddsapi (The Odds API – key in Railway variables only, never in git)
ODDS_PROVIDER=demo
ODDS_API_KEY=

# Email: console (dev: logs only, sign-up codes shown on screen) | smtp | resend | sendgrid
# Live site: Spacemail – smtp, mail.spacemail.com, 465, SMTP_SECURE=true, user info@letbetafrika.online
EMAIL_PROVIDER=console
EMAIL_FROM="LetBetAfrika <info@letbetafrika.online>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
RESEND_API_KEY=
SENDGRID_API_KEY=
SITE_URL=http://127.0.0.1:8080
SUPPORT_EMAIL=info@letbetafrika.online

# Payments: demo (instant credit) | paystack | flutterwave
PAYMENTS_MODE=demo
REQUIRE_KYC=false
