# Copy to .env for local development
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5433/letbet
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080

# SMS for one-time codes: console (dev) | termii
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER=LetBet

# Odds feed: demo | oddsapi (The Odds API – key in Railway variables only, never in git)
ODDS_PROVIDER=demo
ODDS_API_KEY=

# Email: console (dev: logs only, sign-up codes shown on screen) | smtp | resend | sendgrid
# Live site: Spacemail – smtp, mail.spacemail.com, 465, SMTP_SECURE=true, user info@letbetafrika.online
EMAIL_PROVIDER=console
EMAIL_FROM="LetBetAfrika <info@letbetafrika.online>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
RESEND_API_KEY=
SENDGRID_API_KEY=
SITE_URL=http://127.0.0.1:8080
SUPPORT_EMAIL=info@letbetafrika.online

# Payments (server/src/lib/payments.js)
#   live – real money: Nigeria bank transfer confirmed by an admin, Ghana Mobile Money through Paystack (or a manual
#          MoMo number confirmed by an admin), withdrawals paid by an admin. Use this on the live site.
#   demo – deposits are credited instantly (local development and automated tests only; ignored when NODE_ENV=production)
PAYMENTS_MODE=demo
REQUIRE_KYC=false

# Nigeria: the bank account players transfer to (shown on the deposit page). Set these in Railway variables only –
# never in git. The admin portal (Payment settings) can change them; what an admin saves there wins.
NG_BANK_NAME=
NG_BANK_ACCOUNT=
NG_BANK_HOLDER=

# Ghana: Paystack secret key (sk_live_… or sk_test_…) – turns on Mobile Money deposits and payouts through the API.
# Webhook URL to paste in Paystack → Settings → API Keys & Webhooks: <SITE_URL>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# Tests only: point at tools/qa/mock_paystack.js instead of https://api.paystack.co
PAYSTACK_BASE=
# Ghana without Paystack (optional): a MoMo wallet players send to, confirmed by an admin
GH_MOMO_NETWORK=mtn
GH_MOMO_NUMBER=
GH_MOMO_NAME=

# Admins: accounts with these emails become admins when the server starts, and when they sign up or log in
# (comma list). Or run: cd server && node scripts/make-admin.js <phone-or-email>
ADMIN_EMAILS=
# Optional: creates the first ADMIN_EMAILS account with this password (Railway variables only). Applied again only
# when this value changes, so a password changed later in the app is kept. ADMIN_COUNTRY = GH (default) or NG.
ADMIN_PASSWORD=
ADMIN_COUNTRY=GH
